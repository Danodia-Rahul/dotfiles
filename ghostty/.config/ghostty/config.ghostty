# Terminal
term = xterm-256color

## Font
#font-family = JetBrains Mono 
#font-style = Medium
#font-size = 17
#font-family = LythMono Nerd Font
#font-family = Monaspace Neon NF
font-family = JetBrainsMono Nerd Font  
font-size = 18

# theme = Kanagawa Wave
# theme = Solarized Dark Patched
# theme = Solarized Dark Patched
# theme = Solarized Dark Patched
# theme = Solarized Dark Patched
#font-feature = liga
#font-feature = calt
#font-feature = ss01
#font-feature = ss02
#font-feature = ss03
#font-feature = ss04
#font-feature = ss05
#font-feature = ss06
#font-feature = ss07
#font-feature = ss08
# Start

maximize = true

# window-decorations
window-decoration = server 

# close
confirm-close-surface = false

# title bar
gtk-titlebar-hide-when-maximized = true
